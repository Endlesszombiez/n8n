# Copy this file to .env beside your compose.yaml file.
N8N_IMAGE=ghcr.io/endlesszombiez/n8n
N8N_RUNNERS_IMAGE=ghcr.io/endlesszombiez/n8n-runners
N8N_IMAGE_TAG=fork
GENERIC_TIMEZONE=America/New_York
# Set a random secret with at least 32 characters. Both services use this value.
N8N_RUNNERS_AUTH_TOKEN=
